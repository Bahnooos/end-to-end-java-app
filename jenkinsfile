pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'Building the application...'
                
            }
        }
        stage('Docker Build') {
            steps {
                echo 'Building the Docker image...'
                
            }
        }
        stage('Docker Run') {
            steps {
                echo 'Running the Docker container...'
                
            }
        }
    }
}